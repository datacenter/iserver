{
    "name": "my-cluster",
    "openshift_version": "4.18.9",
    "cpu_architecture": "x86_64",
    "base_dns_domain": "ocp.lan",
    "cluster_network_cidr": "10.128.0.0/14",
    "cluster_network_host_prefix": 23,
    "service_network_cidr": "172.30.0.0/16",
    "olm_operators": [{"name":"cnv"}, {"name":"lvm"}],
    "network_type": "OVNKubernetes",
    "iso": "full",
    "ntp": "ntp.domain.com",
    "http_proxy": "http://proxy.domain.com:80",
    "https_proxy": "http://proxy.domain.com:80",
    "no_proxy": "domain.com",
    "ssh_public_key": "ssh-ed25519 AAAAC... username@host",
    "server": [
        {
            "hostname": "bm1",
            "kube": true,
            "redfish": {
                "endpoint_ip": "10.20.20.20",
                "username": "user",
                "password": "pass"
            },
            "ssh": {
                "ip": "10.2.2.2"
            },
            "interface": [
                {
                    "name": "eno5",
                    "mac": "aa:aa:aa:aa:aa:aa"
                },
                {
                    "name": "eno6",
                    "mac": "bb:bb:bb:bb:bb:bb"
                }
            ],
            "nmstate": "bonding.yaml",
            "variables": {
                "BOND": "bond0",
                "BOND_MEMBER_1": "eno5",
                "BOND_MEMBER_2": "eno6",
                "VLAN": "666",
                "IP": "10.2.2.2",
                "PREFIX": "28",
                "GW": "10.2.2.14",
                "DNS_SEARCH": "domain.com",
                "DNS_IP": "10.4.4.4"
            }
        }
    ],
    "web_server": {
        "ip": "localhost",
        "image_base_url": "http://10.10.10.10:8080",
        "image_upload_directory": "/home/user/image"
    },
    "tasks": [
        {
            "cli": {
                "exec": [
                    "oc get node",
                    "list",
                    "of",
                    "any",
                    "commands",
                    "executed in the order of definition",
                    "commands do not break on error"
                ],
                "virtctl": true,
                "helm": true,
                "bashrc": true,
                "cilium": true,
                "hubble": true
            }
        },
        {
            "cni": {
                "ovs": "0.39.0"
            }
        },
        {
            "identity": {
                "provider": "htpasswd",
                "filename": "htpasswd",
                "admin": [
                    "__ALL__"
                ]
            }
        },
        {
            "identity": {
                "provider": "kubeadmin",
                "delete": false
            }
        },
        {
            "ssh": {
                "keys": [
                    "ssh-ed25519 AAAAC... username@host"
                ]
            }
        },
        {
            "nmstate": {
                "lldp": {
                    "nic-fw-disable": true,
                    "enable": true
                }
            },
            "nfd": {},
            "sriov": {
                "policy": [
                    {
                        "interface": "ens1f0",
                        "type": "netdevice",
                        "name": "ens1f0net",
                        "resource": "ens1f0net",
                        "vfs": "64",
                        "range": "0-31"
                    },
                    {
                        "interface": "ens1f0",
                        "type": "vfio-pci",
                        "name": "ens1f0dpdk",
                        "resource": "ens1f0dpdk",
                        "vfs": "64",
                        "range": "32-63"
                    }
                ]
            }
        }
    ],
    "fabric": {
        "controller": [
            {
                "type": "aci",
                "apic": "my-apic",
                "domain": "main",
                "mo_name": "bm1",
                "tenant": "k8s",
                "l3out": "MyL3out",
                "vrf": "MyVRF"
                }
        ],
        "server": [
            {
                "hostname": "bm1",
                "interface": [
                    {
                        "domain": "main",
                        "ip": "10.2.2.2",
                        "gateway": "10.2.2.14/28",
                        "mac": "aa:aa:aa:aa:aa:aa",
                        "bond": true,
                        "trunk": true,
                        "vlan": 666,
                        "node": "100",
                        "port": "1/1/1"
                    },
                    {
                        "domain": "main",
                        "ip": "10.2.2.2",
                        "gateway": "10.2.2.14/28",
                        "mac": "bb:bb:bb:bb:bb:bb",
                        "bond": true,
                        "trunk": true,
                        "vlan": 666,
                        "node": "200",
                        "port": "1/1/1"
                    }
                ]
            }
        ]
    }
}
